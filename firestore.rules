rules_version = '2';
// Règles de sécurité — Repas Séguéla (DESIMONE CI)
// À coller dans Firebase > Firestore Database > Règles, puis « Publier ».
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function myDoc() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(myDoc()) && get(myDoc()).data.active == true; }
    function isAdmin() { return isMember() && get(myDoc()).data.role == 'admin'; }

    // Code d'accès du site : créé une seule fois (première installation),
    // lisible et modifiable uniquement par l'administrateur.
    match /config/access {
      allow read, update: if isAdmin();
      allow create: if signedIn()
        && !exists(/databases/$(db)/documents/config/access)
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 4;
      allow delete: if false;
    }

    // Réglages partagés (prix, heure limite, numéros, départements).
    match /config/settings {
      allow read, write: if isMember();
    }

    // Comptes des agents RH.
    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.active == true
        && (
          (request.resource.data.role == 'rh'
            && request.resource.data.siteCode == get(/databases/$(db)/documents/config/access).data.code)
          ||
          (request.resource.data.role == 'admin'
            && getAfter(/databases/$(db)/documents/config/access).data.adminUid == request.auth.uid)
        );
      allow update: if isAdmin()
        || (uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isAdmin();
    }

    // Commandes journalières : tous les agents RH actifs.
    match /orders/{date} {
      allow read, create, update: if isMember();
      allow delete: if isAdmin();
    }
  }
}
